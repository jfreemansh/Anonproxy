#!/usr/bin/env bash
# Anonproxy quick launcher — per-test profiles, one command each.
#
#   anon                     start the most recent profile (foreground)
#   anon up acme-web         start a specific profile
#   anon up acme-web --daemon / anon stop
#   anon env acme-web        client export lines (--copy for clipboard)
#   anon close acme-web      export evidence files + wipe the vault
#   anon profile new acme-web --scope "acme.com,DC01" [--ephemeral] [...]
#   anon profile list|show|edit|rm
#
# Everything else (serve, verify, anon, deanon, ...) passes through to
# `python3 -m anonproxy`.
#
# Self-locating: resolves its own repo through symlinks and pins PYTHONPATH,
# so it works from any directory and survives moving/renaming the repo.
set -euo pipefail

SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  DIR="$(cd "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  [[ "$SRC" != /* ]] && SRC="$DIR/$SRC"
done
ROOT="$(cd "$(dirname "$SRC")/.." && pwd)"

export PYTHONPATH="${ROOT}${PYTHONPATH:+:$PYTHONPATH}"
PYTHON="${PYTHON_BIN:-python3}"

[ $# -eq 0 ] && set -- up
exec "$PYTHON" -m anonproxy "$@"
